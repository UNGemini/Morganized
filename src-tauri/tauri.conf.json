{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morganized",
  "version": "1.0.0",
  "identifier": "com.morganized.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Morganized",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "minWidth": 850,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 29.0,
          "y": 36.0
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
